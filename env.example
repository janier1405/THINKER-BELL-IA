# Copia a .env (nunca versionar .env). Sin secretos reales aquí.
DATABASE_URL=postgresql+psycopg://thinkerbell:CAMBIAR@localhost:5432/thinkerbell
JWT_SECRET=GENERAR_CON__python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_ENV=development            # production => exige JWT_SECRET>=32 y COOKIE_SECURE=true
SESSION_MINUTES=60
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15
COOKIE_SECURE=false          # true OBLIGATORIO tras HTTPS
CORS_ORIGINS=http://localhost:5173
AUTO_CREATE_TABLES=false     # solo true en desarrollo desechable; usa Alembic
POSTGRES_PASSWORD=CAMBIAR
